# Sourcely environment variables
# Copy this to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://sourcely:sourcely@localhost:5432/sourcely

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# App
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173
